                    "claim": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
